# Credentials for the cloud acceptance suites: copy to .env.acceptance (gitignored) and fill in.
# `make acceptance-cloud` reads it with etl-craft's own parser: values are taken as written.

# Databricks: a SQL warehouse, and a catalog and schema the token may write in. The demo creates
# schemas named ec_<run>_* in the catalog and drops them when it ends.
ETL_CRAFT_TEST_DATABRICKS_JDBC_URL=
ETL_CRAFT_TEST_DATABRICKS_CATALOG=
ETL_CRAFT_TEST_DATABRICKS_SCHEMA=
ETL_CRAFT_TEST_DATABRICKS_TOKEN=

# Snowflake: a programmatic access token, and a database and schema the role may write in. The
# demo creates schemas named EC_<run>_* in the database and drops them when it ends.
ETL_CRAFT_TEST_SNOWFLAKE_ACCOUNT=
ETL_CRAFT_TEST_SNOWFLAKE_USER=
ETL_CRAFT_TEST_SNOWFLAKE_TOKEN=
ETL_CRAFT_TEST_SNOWFLAKE_ROLE=
ETL_CRAFT_TEST_SNOWFLAKE_WAREHOUSE=
ETL_CRAFT_TEST_SNOWFLAKE_DATABASE=
ETL_CRAFT_TEST_SNOWFLAKE_SCHEMA=
