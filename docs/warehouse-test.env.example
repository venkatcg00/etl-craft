# =============================================================================
# etl-craft setup — fill this in, save it as `.env`, then run `uv run etl-craft setup`
# =============================================================================
#
#   cp docs/warehouse-test.env.example .env
#   $EDITOR .env
#   uv run etl-craft setup      # writes craft-connector.yml + creates/migrates the schema
#   uv run etl-craft doctor     # resolves every secret and connection, reports each one
#
# Two things worth knowing before you fill it in:
#
#  * ETL_CRAFT_SOURCE_TYPE=file below makes THIS FILE the secret source too, so config and
#    secrets live in one place while you are testing locally. Keep it out of git.
#  * For CI, set ETL_CRAFT_SOURCE_TYPE=environment instead and leave the
#    *_SECRET lines out of the file entirely — the engine then reads them from
#    the process environment, which is where GitHub Actions puts
#    `env: FOO: ${{ secrets.FOO }}`. Everything else in this file stays the
#    same, so local and CI differ only in where secrets come from.
#  * Secrets follow one rule: <SECTION>_<PROFILE>_SECRET, uppercased, no ETL_CRAFT_
#    prefix. Profile `dev` for the Engine connection -> ENGINE_DEV_SECRET. The
#    plain <SECTION>_SECRET (e.g. ENGINE_SECRET) also works — the tiered form is
#    only needed when one file holds more than one profile at once.
#  * These are also the exact names `setup` writes into craft-connector.yml's own
#    Variables mapping — the bootstrap variable IS the runtime variable, so
#    nothing here is a name `etl-craft run` won't also look for later.
#
# -----------------------------------------------------------------------------
# Execution
# -----------------------------------------------------------------------------
ETL_CRAFT_MODE=local
# ETL_CRAFT_ORCHESTRATOR_NAME=airflow          # informational only

# Where secret values are read from: `file` (this file) or `environment`.
ETL_CRAFT_SOURCE_TYPE=file
ETL_CRAFT_SOURCE_PATH=.env

# -----------------------------------------------------------------------------
# Engine DB — always PostgreSQL. Holds every CFG_/AUD_ table.
# -----------------------------------------------------------------------------
ETL_CRAFT_ENGINE_PROFILE=dev
ENGINE_JDBC_URL=jdbc:postgresql://localhost:55432/etl_craft
ENGINE_USER=etl_craft
ENGINE_AUTH_MODE=password
ENGINE_DEV_SECRET=etl_craft

# -----------------------------------------------------------------------------
# Warehouse — DuckDB is active below for a runnable local default. Pick one
# other block instead when you need a different warehouse.
# Only SQL and BUSINESS_RULES tasks need it.
# -----------------------------------------------------------------------------
ETL_CRAFT_WAREHOUSE_PROFILE=dev

# --- Option A: Databricks (Unity Catalog) — TESTED AND RECOMMENDED ----------
# Install the dialect first:  uv sync --extra databricks
#
# Verified live 2026-09-23 against a real Databricks SQL warehouse:
# CREATE_TABLE/OVERWRITE_TABLE/SCD1_MERGE (insert + matched-row update) both
# with Table_format: native (managed Delta) and Table_format: iceberg (managed
# Delta with UniForm enabled — see CLAUDE.md's "Where things stand" for the
# full story of why UniForm, not a literal `USING ICEBERG` clause).
#
# Where each value comes from in the Databricks UI:
#   <host>        SQL Warehouses -> your warehouse -> Connection details ->
#                 "Server hostname"      e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com
#   <http-path>   same panel -> "HTTP path"   e.g. /sql/1.0/warehouses/abc123def456
#   <catalog>     Catalog explorer. Free Edition usually has `workspace`.
#   token         Settings -> Developer -> Access tokens -> Generate new token
#
# This is the preferred connection shape: catalog and schema are their own
# fields, not packed into the JDBC URL's query string, and `setup` reads it
# when WAREHOUSE_TOKEN is set (WAREHOUSE_NAME picks Databricks vs. Snowflake
# below it). auth_mode is always `token` for this shape and is not set
# separately. These four names are read directly at `setup` time -- they do
# not follow this file's tiered <SECTION>_<PROFILE>_SECRET convention, since
# `setup` is a one-shot bootstrap read, not a runtime secret lookup.
#
#WAREHOUSE_NAME=Databricks
#WAREHOUSE_JDBC_URL=jdbc:databricks://<host>:443/default;httpPath=<http-path>
#WAREHOUSE_CATALOG=<catalog>
#WAREHOUSE_SCHEMA=<schema>
#WAREHOUSE_TOKEN=<your-databricks-personal-access-token>
# (no WAREHOUSE_USER — the username is the literal "token" and is set for you)

# --- Option B: Snowflake ------------------------------------------------------
# Install the dialect first:  uv sync --extra snowflake
#
# Where each value comes from:
#   <account>   Snowsight -> bottom-left account menu -> "Account details" ->
#               Account identifier, written as <orgname>-<account_name>
#   <db>,<schema>,<warehouse>  whatever you created; COMPUTE_WH is the default
#
# B0. PROGRAMMATIC ACCESS TOKEN (PAT) — the preferred connection shape:
#     separate fields instead of one JDBC URL with the database, schema,
#     warehouse and role packed into its query string. `setup` reads it when
#     WAREHOUSE_TOKEN is set, the same one-shot bootstrap read Databricks'
#     Option A above uses (not this file's tiered <SECTION>_<PROFILE>_SECRET
#     convention).
#
#     IMPORTANT — Snowflake requires a network policy assigned to the account
#     or the user before a PAT can authenticate at all: Snowsight -> Admin ->
#     Security -> Network Policies. Without one, every connection attempt
#     fails with "Network policy is required", regardless of how correct the
#     token and other fields are — this is a Snowflake account setting, not
#     an etl-craft configuration problem, so fix it there first if you hit it.
#
#     Generate a PAT: Snowsight -> your user menu -> Settings -> Authentication
#     -> Programmatic access tokens -> Generate new token.
#
#WAREHOUSE_NAME=Snowflake
#WAREHOUSE_USER=<your-snowflake-login-name>
#WAREHOUSE_ACCOUNT=<account>
#WAREHOUSE_DATABASE=<db>
#WAREHOUSE_SCHEMA=<schema>
#WAREHOUSE_WAREHOUSE=<warehouse>
#WAREHOUSE_ROLE=<role>
#WAREHOUSE_TOKEN=<your-programmatic-access-token>
#
# B1. KEY-PAIR (RSA) — an alternative for a team standardising on RSA
#     key-pair auth instead of PATs. It is what a corporate Snowflake project
#     uses for anything automated: Snowflake has been moving service accounts
#     off single-factor passwords, so key-pair is the expected mechanism for a
#     service account, and it is the only one of the two that works unattended
#     once MFA is enforced.
#
#     Generate a key pair and register the public half:
#       openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
#       openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
#       # then in Snowflake, as ACCOUNTADMIN:
#       ALTER USER <login> SET RSA_PUBLIC_KEY='<contents of rsa_key.pub, no header/footer>';
#
#     The SECRET below is the key's *passphrase* (leave empty if you generated
#     it without one). The key itself never goes in this file or in
#     craft-connector.yml — only the path to it.
#
#WAREHOUSE_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<warehouse>&role=<role>
#WAREHOUSE_USER=<your-snowflake-login-name>
#WAREHOUSE_AUTH_MODE=key_file
#WAREHOUSE_KEY_FILE=/absolute/path/to/rsa_key.p8
#WAREHOUSE_DEV_SECRET=<key passphrase, or leave empty if unencrypted>
#
#     In CI, keep the same auth_mode and write the key out from a secret in a
#     setup step, so nothing changes between local and CI except where the file
#     comes from:
#       - run: |
#           printf '%s' "${{ secrets.SNOWFLAKE_PRIVATE_KEY }}" > "$RUNNER_TEMP/rsa_key.p8"
#           chmod 600 "$RUNNER_TEMP/rsa_key.p8"
#         env vars: WAREHOUSE_KEY_FILE=$RUNNER_TEMP/rsa_key.p8
#                   WAREHOUSE_DEV_SECRET=${{ secrets.SNOWFLAKE_KEY_PASSPHRASE }}
#     (with ETL_CRAFT_SOURCE_TYPE=environment in CI, so secrets come from the
#     process environment rather than a file on disk)
#
# B2. PASSWORD — simpler, fine for poking at a trial account by hand. Not what
#     a corporate project should use, and it stops working once the account
#     enforces MFA.
#
#WAREHOUSE_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<warehouse>
#WAREHOUSE_USER=<your-snowflake-login-name>
#WAREHOUSE_AUTH_MODE=password
#WAREHOUSE_DEV_SECRET=<your-snowflake-password>
#
# B3. BROWSER SSO — requires a SAML identity provider configured in Snowflake.
# A normal Snowsight password login alone does not configure browser SSO.
#WAREHOUSE_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<warehouse>&authenticator=externalbrowser
#WAREHOUSE_USER=<your-snowflake-login-name>
#WAREHOUSE_AUTH_MODE=none
# No secret is needed: the Snowflake driver opens the browser for SSO.
# The integration fixture also recognizes authenticator=externalbrowser in
# ETL_CRAFT_TEST_SNOWFLAKE_JDBC_URL and does not require a password/key file.
#
# Snowflake Iceberg tables (Table_format: iceberg) are zero-config: with no
# EXTERNAL_VOLUME/BASE_LOCATION declared, the engine uses
# EXTERNAL_VOLUME = 'SNOWFLAKE_MANAGED' -- Snowflake's own internal storage,
# not a customer bucket -- verified live 2026-09-23 against the full SQL
# action vocabulary. No cloud storage to provision, even on a trial account.
# To place a table's data in your own external volume instead (e.g. so
# another engine can read the same physical files), declare these two as
# CFG_TASK_PARAMETERS on that SQL task (not here -- they are per-target, not
# per-connection):
#     EXTERNAL_VOLUME = <your external volume name>
#     BASE_LOCATION   = <path within it, e.g. analytics/customers>

# --- Option C: PostgreSQL as the warehouse (no caveats, good for a first run) --
#WAREHOUSE_JDBC_URL=jdbc:postgresql://localhost:55432/analytics
#WAREHOUSE_USER=etl_craft
#WAREHOUSE_AUTH_MODE=password
#WAREHOUSE_DEV_SECRET=etl_craft

# --- Option D: DuckDB (local file, nothing to authenticate to) ----------------
WAREHOUSE_JDBC_URL=jdbc:duckdb:./warehouse.duckdb
WAREHOUSE_AUTH_MODE=none
ETL_CRAFT_WAREHOUSE_TABLE_FORMAT=native

# -----------------------------------------------------------------------------
# Cloning — mirrors CFG_/AUD_ tables into the warehouse. Off by default.
# EXTERNAL_VOLUME/BASE_LOCATION are only needed when the clone target is a
# Snowflake Iceberg warehouse (cloning.py refuses to create a mirrored table
# there without them, the same guard sql_actions.py uses for ordinary
# targets). Leave both unset for every other warehouse.
# -----------------------------------------------------------------------------
ETL_CRAFT_CLONING_ENABLED=false
ETL_CRAFT_CLONING_SCOPE=cfg
#ETL_CRAFT_CLONING_EXTERNAL_VOLUME=<your external volume name>
#ETL_CRAFT_CLONING_BASE_LOCATION=<path within it, e.g. analytics/cloning>
