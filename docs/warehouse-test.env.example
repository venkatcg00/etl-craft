# =============================================================================
# etl-craft setup — fill this in, save it as `.env`, then run `uv run etl-craft setup`
# =============================================================================
#
#   cp docs/warehouse-test.env.example .env
#   $EDITOR .env
#   uv run etl-craft setup      # writes craft-connector.yml + creates/migrates the schema
#   uv run etl-craft doctor     # resolves every secret and connection, reports each one
#
# Two things worth knowing before you fill it in:
#
#  * ETL_CRAFT_SOURCE_TYPE=file below makes THIS FILE the secret source too, so config and
#    secrets live in one place while you are testing locally. Keep it out of git.
#  * For CI, set ETL_CRAFT_SOURCE_TYPE=environment instead and leave the
#    *_SECRET lines out of the file entirely — the engine then reads them from
#    the process environment, which is where GitHub Actions puts
#    `env: FOO: ${{ secrets.FOO }}`. Everything else in this file stays the
#    same, so local and CI differ only in where secrets come from.
#  * Secrets follow one rule: ETL_CRAFT_<SECTION>_<PROFILE>_SECRET, uppercased.
#    Profile `dev` for the Engine connection -> ETL_CRAFT_POSTGRES_DEV_SECRET.
#
# -----------------------------------------------------------------------------
# Execution
# -----------------------------------------------------------------------------
ETL_CRAFT_MODE=local
# ETL_CRAFT_ORCHESTRATOR_NAME=airflow          # informational only

# Where secret values are read from: `file` (this file) or `environment`.
ETL_CRAFT_SOURCE_TYPE=file
ETL_CRAFT_SOURCE_PATH=.env

# -----------------------------------------------------------------------------
# Engine DB — always PostgreSQL. Holds every CFG_/AUD_ table.
# -----------------------------------------------------------------------------
ETL_CRAFT_POSTGRES_PROFILE=dev
ETL_CRAFT_POSTGRES_JDBC_URL=jdbc:postgresql://localhost:55432/etl_craft
ETL_CRAFT_POSTGRES_USER=etl_craft
ETL_CRAFT_POSTGRES_AUTH_MODE=password
ETL_CRAFT_POSTGRES_DEV_SECRET=etl_craft

# -----------------------------------------------------------------------------
# Warehouse — DuckDB is active below for a runnable local default. Pick one
# other block instead when you need a different warehouse.
# Only SQL and BUSINESS_RULES tasks need it.
# -----------------------------------------------------------------------------
ETL_CRAFT_WAREHOUSE_PROFILE=dev

# --- Option A: Databricks (Unity Catalog) ------------------------------------
# Install the dialect first:  uv sync --extra databricks
#
# Where each value comes from in the Databricks UI:
#   <host>        SQL Warehouses -> your warehouse -> Connection details ->
#                 "Server hostname"      e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com
#   <http-path>   same panel -> "HTTP path"   e.g. /sql/1.0/warehouses/abc123def456
#   <catalog>     Catalog explorer. Free Edition usually has `workspace`.
#   token         Settings -> Developer -> Access tokens -> Generate new token
#
# ConnCatalog is REQUIRED: it is the catalog half of the three-part
# catalog.schema.table name that TARGET_OBJECT resolves against.
#
#ETL_CRAFT_WAREHOUSE_JDBC_URL=jdbc:databricks://<host>:443/default;httpPath=<http-path>;ConnCatalog=<catalog>
#ETL_CRAFT_WAREHOUSE_AUTH_MODE=token
#ETL_CRAFT_WAREHOUSE_DEV_SECRET=<your-databricks-personal-access-token>
# (no ETL_CRAFT_WAREHOUSE_USER — the username is the literal "token" and is set for you)

# --- Option B: Snowflake ------------------------------------------------------
# Install the dialect first:  uv sync --extra snowflake
#
# Where each value comes from:
#   <account>   Snowsight -> bottom-left account menu -> "Account details" ->
#               Account identifier, written as <orgname>-<account_name>
#   <db>,<schema>,<warehouse>  whatever you created; COMPUTE_WH is the default
#
# B1. KEY-PAIR (RSA) — use this one. It is what a corporate Snowflake project
#     uses for anything automated: Snowflake has been moving service accounts
#     off single-factor passwords, so key-pair is the expected mechanism for a
#     service account, and it is the only one of the two that works unattended
#     once MFA is enforced.
#
#     Generate a key pair and register the public half:
#       openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
#       openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
#       # then in Snowflake, as ACCOUNTADMIN:
#       ALTER USER <login> SET RSA_PUBLIC_KEY='<contents of rsa_key.pub, no header/footer>';
#
#     The SECRET below is the key's *passphrase* (leave empty if you generated
#     it without one). The key itself never goes in this file or in
#     craft-connector.yml — only the path to it.
#
#ETL_CRAFT_WAREHOUSE_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<warehouse>&role=<role>
#ETL_CRAFT_WAREHOUSE_USER=<your-snowflake-login-name>
#ETL_CRAFT_WAREHOUSE_AUTH_MODE=key_file
#ETL_CRAFT_WAREHOUSE_KEY_FILE=/absolute/path/to/rsa_key.p8
#ETL_CRAFT_WAREHOUSE_DEV_SECRET=<key passphrase, or leave empty if unencrypted>
#
#     In CI, keep the same auth_mode and write the key out from a secret in a
#     setup step, so nothing changes between local and CI except where the file
#     comes from:
#       - run: |
#           printf '%s' "${{ secrets.SNOWFLAKE_PRIVATE_KEY }}" > "$RUNNER_TEMP/rsa_key.p8"
#           chmod 600 "$RUNNER_TEMP/rsa_key.p8"
#         env vars: ETL_CRAFT_WAREHOUSE_KEY_FILE=$RUNNER_TEMP/rsa_key.p8
#                   ETL_CRAFT_WAREHOUSE_DEV_SECRET=${{ secrets.SNOWFLAKE_KEY_PASSPHRASE }}
#     (with ETL_CRAFT_SOURCE_TYPE=environment in CI, so secrets come from the
#     process environment rather than a file on disk)
#
# B2. PASSWORD — simpler, fine for poking at a trial account by hand. Not what
#     a corporate project should use, and it stops working once the account
#     enforces MFA.
#
#ETL_CRAFT_WAREHOUSE_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<warehouse>
#ETL_CRAFT_WAREHOUSE_USER=<your-snowflake-login-name>
#ETL_CRAFT_WAREHOUSE_AUTH_MODE=password
#ETL_CRAFT_WAREHOUSE_DEV_SECRET=<your-snowflake-password>
#
# READ THIS before testing SQL tasks on Snowflake: creating an Iceberg table
# there needs an EXTERNAL VOLUME backed by your own S3/Azure/GCS bucket, which a
# trial account does not come with. Without one the engine refuses to create the
# table rather than silently making an ordinary (non-Iceberg) Snowflake table.
# If you do have a bucket, declare these two as CFG_TASK_PARAMETERS on each SQL
# task (not here — they are per-target, not per-connection):
#     EXTERNAL_VOLUME = <your external volume name>
#     BASE_LOCATION   = <path within it, e.g. analytics/customers>
# Connection, auth, `doctor` and the read-only verbs all work regardless.

# --- Option C: PostgreSQL as the warehouse (no caveats, good for a first run) --
#ETL_CRAFT_WAREHOUSE_JDBC_URL=jdbc:postgresql://localhost:55432/analytics
#ETL_CRAFT_WAREHOUSE_USER=etl_craft
#ETL_CRAFT_WAREHOUSE_AUTH_MODE=password
#ETL_CRAFT_WAREHOUSE_DEV_SECRET=etl_craft

# --- Option D: DuckDB (local file, nothing to authenticate to) ----------------
ETL_CRAFT_WAREHOUSE_JDBC_URL=jdbc:duckdb:./warehouse.duckdb
ETL_CRAFT_WAREHOUSE_AUTH_MODE=none
ETL_CRAFT_WAREHOUSE_TABLE_FORMAT=native

# -----------------------------------------------------------------------------
# Cloning — mirrors CFG_/AUD_ tables into the warehouse. Off by default.
# -----------------------------------------------------------------------------
ETL_CRAFT_CLONING_ENABLED=false
ETL_CRAFT_CLONING_SCOPE=cfg
