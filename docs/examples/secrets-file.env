# The secrets file secrets-file.yml points at: KEY=VALUE per line, '#' comments.
# Placeholder values only -- a real one holds real secrets and stays out of
# version control. A value may be wrapped in one pair of quotes, which is removed.
ENGINE_JDBC_URL=jdbc:postgresql://engine-db.internal:5432/etl_craft
ENGINE_USER=etl_craft
ENGINE_AUTH_MODE=password
ENGINE_SECRET=change-me

WAREHOUSE_JDBC_URL=jdbc:postgresql://warehouse-db.internal:5432/analytics
WAREHOUSE_USER=etl_craft
WAREHOUSE_AUTH_MODE=password
WAREHOUSE_SECRET=change-me

# Profile-specific names win over the plain ones for that profile.
ENGINE_PROD_SECRET=change-me-too
