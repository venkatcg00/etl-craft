# =============================================================================
# Every variable craft-connector.yml refers to. Assign the ones you use.
# =============================================================================
#
# craft-connector.yml holds only NAMES. This is where the values live —
# either as a file (Secrets.Source_type: file, Source_path pointing here) or
# exported into the environment (Secrets.Source_type: environment).
#
# There is ONE set of names, with no environment tier in them. A dev machine
# and a prod container both set ENGINE_JDBC_URL; they just set it to different
# values. `Profile` in the YAML (or $ETL_CRAFT_ENGINE_PROFILE) says which tier
# this deployment is — the variable names do not repeat that, because two
# places saying the same thing can disagree, and because a tier in the name
# would force the same image to use a different variable name per environment.
#
# A missing variable for an active section fails at `etl-craft setup`, by name,
# before anything runs.
#
# Rename these freely — they are whatever the YAML says they are. The names
# below are what the two shipped examples use.
#
# -----------------------------------------------------------------------------
# Which tier is live. These selectors are read from the process environment,
# not from a file named by Secrets.Source_path. Export either to override the
# YAML's Profile without editing the file.
# -----------------------------------------------------------------------------
# export ETL_CRAFT_ENGINE_PROFILE=dev
# export ETL_CRAFT_WAREHOUSE_PROFILE=dev

# -----------------------------------------------------------------------------
# Holding several tiers in ONE file (a laptop only)
# -----------------------------------------------------------------------------
# A tier-scoped name wins over the plain one when it is present, so a single
# file can carry dev and uat side by side. Export ETL_CRAFT_ENGINE_PROFILE to
# choose which tier wins:
#
#   ENGINE_DEV_JDBC_URL=jdbc:postgresql://localhost:55432/etl_craft
#   ENGINE_UAT_JDBC_URL=jdbc:postgresql://uat-host:5432/etl_craft
#
# This is a lookup fallback only — nothing in craft-connector.yml mentions the
# suffix. In CI and in containers, ignore it and set the plain names below.
# -----------------------------------------------------------------------------

# =============================================================================
# ENGINE DB — always PostgreSQL. Holds every CFG_/AUD_ table.
# auth_mode is one of: password | key_file
# =============================================================================
ENGINE_JDBC_URL=jdbc:postgresql://localhost:55432/etl_craft
ENGINE_USER=etl_craft
ENGINE_AUTH_MODE=password
ENGINE_SECRET=etl_craft

# =============================================================================
# WAREHOUSE — fill these to match your Warehouse.Name.
# Set Warehouse.Table_format to iceberg or native in craft-connector.yml.
#
# KEY_FILE only applies to auth_mode=key_file (Snowflake); leave it out otherwise.
# Databricks needs no WAREHOUSE_USER: its username is the literal "token".
# =============================================================================
#WAREHOUSE_JDBC_URL=
#WAREHOUSE_USER=
#WAREHOUSE_AUTH_MODE=
#WAREHOUSE_SECRET=
#WAREHOUSE_KEY_FILE=

# --- What each engine expects in those variables -----------------------------
#
# --- Warehouse.Name: Postgres ------------------------------------------------
#WAREHOUSE_JDBC_URL=jdbc:postgresql://localhost:55432/analytics
#WAREHOUSE_USER=etl_craft
#WAREHOUSE_AUTH_MODE=password
#WAREHOUSE_SECRET=

# --- Warehouse.Name: Databricks (Unity Catalog) ------------------------------
# host + HTTP path: SQL Warehouses -> your warehouse -> Connection details
# token: Settings -> Developer -> Access tokens
# ConnCatalog is required — it is the catalog half of catalog.schema.table.
# No WAREHOUSE_USER: the username is the literal "token" and the engine supplies it.
#WAREHOUSE_JDBC_URL=jdbc:databricks://<host>:443/default;httpPath=/sql/1.0/warehouses/<id>;ConnCatalog=<catalog>
#WAREHOUSE_AUTH_MODE=token
#WAREHOUSE_SECRET=<databricks personal access token>

# --- Warehouse.Name: Snowflake (Iceberg tables) ------------------------------
# <account> is the identifier from Snowsight -> Account details, as <org>-<account>.
# key_file is the corporate standard; the SECRET is the key's *passphrase*
# (leave empty for an unencrypted key). Generate and register the key with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
#   ALTER USER <login> SET RSA_PUBLIC_KEY='<contents of rsa_key.pub>';
#WAREHOUSE_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<wh>
#WAREHOUSE_USER=<snowflake login name>
#WAREHOUSE_AUTH_MODE=key_file
#WAREHOUSE_KEY_FILE=/absolute/path/to/rsa_key.p8
#WAREHOUSE_SECRET=<key passphrase, empty if unencrypted>
#
# Creating an Iceberg table on Snowflake also needs an EXTERNAL VOLUME over your
# own S3/Azure/GCS bucket. That is per-target, so it lives in
# CFG_TASK_PARAMETERS (EXTERNAL_VOLUME, BASE_LOCATION), not here. A local MinIO
# cannot serve it: Snowflake's own cloud service reads the bucket.

# --- Warehouse.Name: Trino over Iceberg --------------------------------------
# `none` is a real auth_mode for an open cluster, and needs no SECRET.
#WAREHOUSE_JDBC_URL=jdbc:trino://<host>:8080/<catalog>/<schema>
#WAREHOUSE_USER=etl
#WAREHOUSE_AUTH_MODE=none
#WAREHOUSE_SECRET=


# =============================================================================
# EMAIL (SMTP) — only needed if an active task uses HANDLER=EMAIL_ALERT.
# auth_mode here is `none` or `password` only. With `none` there is no USER and
# no SECRET to set; the relay simply accepts the message.
# =============================================================================
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_FROM=etl-craft@example.com
EMAIL_AUTH_MODE=none
EMAIL_USER=
EMAIL_USE_TLS=false
EMAIL_SECRET=
