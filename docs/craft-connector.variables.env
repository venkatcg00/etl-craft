# =============================================================================
# Every variable craft-connector.yml refers to. Assign the ones you use.
# =============================================================================
#
# craft-connector.yml holds only NAMES. This is where the values live —
# either as a file (Secrets.Source_type: file, Source_path pointing here) or
# exported into the environment (Secrets.Source_type: environment).
#
# You only need the profiles you actually run. A profile named in the YAML but
# never made active costs nothing; a profile that IS active and has a missing
# variable fails at `etl-craft setup`, by name, before anything runs.
#
# Rename these freely — they are whatever the YAML says they are. The names
# below are what the two shipped examples use.
#
# -----------------------------------------------------------------------------
# Which profile is live. Both are optional: set either one to override the
# YAML's Active_profile without editing the file. This is how one image or one
# checkout serves dev/sit/uat/prod.
# -----------------------------------------------------------------------------
#ETL_CRAFT_ENGINE_PROFILE=dev
#ETL_CRAFT_WAREHOUSE_PROFILE=dev

# =============================================================================
# ENGINE DB — always PostgreSQL. Holds every CFG_/AUD_ table.
# auth_mode is one of: password | key_file | token | sso
# =============================================================================
ENGINE_LOCAL_JDBC_URL=jdbc:postgresql://localhost:55432/etl_craft
ENGINE_LOCAL_USER=etl_craft
ENGINE_LOCAL_AUTH_MODE=password
ENGINE_LOCAL_SECRET=etl_craft

ENGINE_DEV_JDBC_URL=
ENGINE_DEV_USER=
ENGINE_DEV_AUTH_MODE=password
ENGINE_DEV_SECRET=

ENGINE_SIT_JDBC_URL=
ENGINE_SIT_USER=
ENGINE_SIT_AUTH_MODE=password
ENGINE_SIT_SECRET=

ENGINE_UAT_JDBC_URL=
ENGINE_UAT_USER=
ENGINE_UAT_AUTH_MODE=password
ENGINE_UAT_SECRET=

ENGINE_PROD_JDBC_URL=
ENGINE_PROD_USER=
ENGINE_PROD_AUTH_MODE=password
ENGINE_PROD_SECRET=

# =============================================================================
# WAREHOUSE — pick the block matching your Warehouse.Name and fill that one.
# Every table the engine creates on a non-Postgres warehouse is an Iceberg table.
# =============================================================================

# --- The variables themselves, one set per tier. Fill the tiers you run. ---
# KEY_FILE only applies to auth_mode=key_file (Snowflake); leave it out otherwise.
# Databricks needs no *_USER: its username is the literal "token".

#WAREHOUSE_LOCAL_JDBC_URL=
#WAREHOUSE_LOCAL_USER=
#WAREHOUSE_LOCAL_AUTH_MODE=
#WAREHOUSE_LOCAL_SECRET=
#WAREHOUSE_LOCAL_KEY_FILE=

#WAREHOUSE_DEV_JDBC_URL=
#WAREHOUSE_DEV_USER=
#WAREHOUSE_DEV_AUTH_MODE=
#WAREHOUSE_DEV_SECRET=
#WAREHOUSE_DEV_KEY_FILE=

#WAREHOUSE_SIT_JDBC_URL=
#WAREHOUSE_SIT_USER=
#WAREHOUSE_SIT_AUTH_MODE=
#WAREHOUSE_SIT_SECRET=
#WAREHOUSE_SIT_KEY_FILE=

#WAREHOUSE_UAT_JDBC_URL=
#WAREHOUSE_UAT_USER=
#WAREHOUSE_UAT_AUTH_MODE=
#WAREHOUSE_UAT_SECRET=
#WAREHOUSE_UAT_KEY_FILE=

#WAREHOUSE_PROD_JDBC_URL=
#WAREHOUSE_PROD_USER=
#WAREHOUSE_PROD_AUTH_MODE=
#WAREHOUSE_PROD_SECRET=
#WAREHOUSE_PROD_KEY_FILE=

# --- What each engine expects in those variables -------------------------
#
# --- Warehouse.Name: Postgres -------------------------------------------------
#WAREHOUSE_DEV_JDBC_URL=jdbc:postgresql://localhost:55432/analytics
#WAREHOUSE_DEV_USER=etl_craft
#WAREHOUSE_DEV_AUTH_MODE=password
#WAREHOUSE_DEV_SECRET=

# --- Warehouse.Name: Databricks (Unity Catalog) -------------------------------
# host + HTTP path: SQL Warehouses -> your warehouse -> Connection details
# token: Settings -> Developer -> Access tokens
# ConnCatalog is required — it is the catalog half of catalog.schema.table.
# No *_USER: the username is the literal "token" and the engine supplies it.
#WAREHOUSE_DEV_JDBC_URL=jdbc:databricks://<host>:443/default;httpPath=/sql/1.0/warehouses/<id>;ConnCatalog=<catalog>
#WAREHOUSE_DEV_AUTH_MODE=token
#WAREHOUSE_DEV_SECRET=<databricks personal access token>

# --- Warehouse.Name: Snowflake (Iceberg tables) -------------------------------
# <account> is the identifier from Snowsight -> Account details, as <org>-<account>.
# key_file is the corporate standard; the SECRET is the key's *passphrase*
# (leave empty for an unencrypted key). Generate and register the key with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub
#   ALTER USER <login> SET RSA_PUBLIC_KEY='<contents of rsa_key.pub>';
#WAREHOUSE_DEV_JDBC_URL=jdbc:snowflake://<account>.snowflakecomputing.com/?db=<db>&schema=<schema>&warehouse=<wh>
#WAREHOUSE_DEV_USER=<snowflake login name>
#WAREHOUSE_DEV_AUTH_MODE=key_file
#WAREHOUSE_DEV_KEY_FILE=/absolute/path/to/rsa_key.p8
#WAREHOUSE_DEV_SECRET=<key passphrase, empty if unencrypted>
#
# Creating an Iceberg table on Snowflake also needs an EXTERNAL VOLUME over your
# own S3/Azure/GCS bucket. That is per-target, so it lives in
# CFG_TASK_PARAMETERS (EXTERNAL_VOLUME, BASE_LOCATION), not here. A local MinIO
# cannot serve it: Snowflake's own cloud service reads the bucket.

# --- Warehouse.Name: Trino, or any SQL engine over plain Iceberg --------------
# `none` is a real auth_mode for an open cluster, and needs no SECRET.
#WAREHOUSE_DEV_JDBC_URL=jdbc:trino://<host>:8080/<catalog>/<schema>
#WAREHOUSE_DEV_USER=etl
#WAREHOUSE_DEV_AUTH_MODE=none
#WAREHOUSE_DEV_SECRET=


# =============================================================================
# EMAIL (SMTP) — only needed if an active task uses HANDLER=EMAIL_ALERT.
# auth_mode here is `none` or `password` only. With `none` there is no USER and
# no SECRET to set; the relay simply accepts the message.
# =============================================================================
EMAIL_DEV_HOST=localhost
EMAIL_DEV_PORT=1025
EMAIL_DEV_FROM=etl-craft@example.com
EMAIL_DEV_AUTH_MODE=none
EMAIL_DEV_USER=
EMAIL_DEV_USE_TLS=false
EMAIL_DEV_SECRET=

#EMAIL_PROD_HOST=
#EMAIL_PROD_PORT=587
#EMAIL_PROD_FROM=
#EMAIL_PROD_AUTH_MODE=password
#EMAIL_PROD_USER=
#EMAIL_PROD_USE_TLS=true
#EMAIL_PROD_SECRET=
